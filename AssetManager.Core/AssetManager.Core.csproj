<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared domain layer: entities, DbContext and all business logic, used by both the WPF desktop
    app and the Blazor web app.

    Deliberately provider-neutral - no Npgsql or SqlServer reference here. Each front end picks its
    own provider; TrackingStore adapts via Database.ProviderName.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AssetManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
  </ItemGroup>

</Project>
