<Window x:Class="AssetManager.StartupSplash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="Initializing..." Height="160" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <!-- WpfAnimatedGif 2.x exposes its attached properties through a clr-namespace mapping;
         the old codeplex XML namespace URI no longer resolves. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" gif:ImageBehavior.AnimatedSource="Assets/loading.gif"
               Width="250" Height="200" ClipToBounds="True" Margin="-70,-20,0,0">
            <Image.Clip>
                <RectangleGeometry Rect="80,20,100,100"/>
            </Image.Clip>
        </Image>

        <TextBlock Grid.Column="1" Name="InitializeText" Text="Initializing..." TextWrapping="Wrap"
                   FontSize="24" Margin="8" VerticalAlignment="Center"/>
    </Grid>
</Window>
