<UserControl x:Class="AssetManager.Views.UserControls.ItemHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="800">
    <!-- Bound to a BatchLineViewModel: shows which purchase lots paid for that line. -->
    <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding CostHistory}"
              HeadersVisibility="Column" Background="WhiteSmoke">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Used Adjusted Units" Binding="{Binding AdjustedQuantity, Mode=OneWay, StringFormat=N2}"/>
            <DataGridTextColumn Header="Adjusted Price / Unit" Binding="{Binding AdjustedUnitPrice, Mode=OneWay, StringFormat=N2}"/>
            <DataGridTextColumn Header="Extended" Binding="{Binding ExtendedCost, Mode=OneWay, StringFormat=N2}"/>
            <DataGridTextColumn Header="Source" Binding="{Binding OrderItem.Order.Source, Mode=OneWay}"/>
            <DataGridTextColumn Header="Order Date" Binding="{Binding OrderItem.Order.DatePlaced, Mode=OneWay, StringFormat=d}"/>
            <DataGridTextColumn Header="Receipt Date" Binding="{Binding OrderItem.Order.DateReceived, Mode=OneWay, StringFormat=d}"/>
            <DataGridTextColumn Header="Unit" Binding="{Binding OrderItem.UnitOfMeasure.Name, Mode=OneWay}"/>
            <DataGridTextColumn Header="Price / Unit" Binding="{Binding OrderItem.UnitPrice, Mode=OneWay, StringFormat=N2}"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
