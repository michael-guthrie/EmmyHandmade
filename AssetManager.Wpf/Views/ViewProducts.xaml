<Window x:Class="AssetManager.Views.ViewProducts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AssetManager.ViewModels"
        mc:Ignorable="d"
        Title="View Products" Height="500" Width="760"
        d:DataContext="{d:DesignInstance Type=vm:ViewProductViewModel}"
        Icon="/Assets/Custom-Icon-Design-Pretty-Office-3-Product-sales-report.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  ItemsSource="{Binding Products}" VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Product.Name, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                <DataGridTextColumn Binding="{Binding TotalProduced, Mode=OneWay, StringFormat=0.0#####}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock>Total<LineBreak/>Produced</TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Total Out" Binding="{Binding TotalOut, Mode=OneWay, StringFormat=0.0#####}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Remain" Binding="{Binding Remaining, Mode=OneWay, StringFormat=0.0#####}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding RemainingValue, Mode=OneWay, StringFormat=N2}" Width="90" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock>Remaining<LineBreak/>Value</TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Cost Per" Binding="{Binding CostPer, Mode=OneWay, StringFormat=0.0#####}" Width="70" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="2" Width="80"/>
            <Button Content="Close" Click="CloseButton_Click" Margin="2" Width="80"/>
        </StackPanel>

        <Grid Grid.ColumnSpan="99" Grid.RowSpan="99" Background="Gray" Opacity="0.6"
              Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisConverter}}"/>
        <TextBlock Grid.ColumnSpan="99" Grid.RowSpan="99" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="24" FontStyle="Oblique" FontWeight="Bold" Text="Loading..."
                   Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisConverter}}"/>
    </Grid>
</Window>
