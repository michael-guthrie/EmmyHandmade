<Window x:Class="AssetManager.Views.ManageItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:AssetManager.Helpers"
        xmlns:uc="clr-namespace:AssetManager.Views.UserControls"
        xmlns:vm="clr-namespace:AssetManager.ViewModels"
        mc:Ignorable="d"
        Title="Manage Items" Height="600" Width="640"
        d:DataContext="{d:DesignInstance Type=vm:ManageItemsViewModel}"
        Icon="/Assets/Custom-Icon-Design-Pretty-Office-3-Item-configuration.ico">
    <Grid>
        <Grid.Resources>
            <!-- DataGrid columns live outside the visual tree; this carries the
                 window DataContext across to their ItemsSource bindings. -->
            <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Unit lists come from the shared LookupCache the view model exposes, rather than from
             three separate XAML resources that each opened their own connection. -->
        <DataGrid Grid.Row="0" AutoGenerateColumns="False" ItemsSource="{Binding Items}"
                  CanUserAddRows="True" CanUserDeleteRows="True" VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item ID" Binding="{Binding Id, Mode=OneWay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="200"/>
                <DataGridComboBoxColumn Header="Units" MinWidth="80"
                                        ItemsSource="{Binding Data.Lookups.Units, Source={StaticResource Proxy}}"
                                        DisplayMemberPath="Value" SelectedValuePath="Key"
                                        SelectedValueBinding="{Binding UnitOfMeasureId, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="Alternate&#x0a;Units" MinWidth="80"
                                        ItemsSource="{Binding Data.Lookups.NullableUnits, Source={StaticResource Proxy}}"
                                        DisplayMemberPath="Value" SelectedValuePath="Key"
                                        SelectedValueBinding="{Binding AlternateUnitOfMeasureId, UpdateSourceTrigger=PropertyChanged}"/>
                <uc:DataGridDecimalColumn Header="Conversion&#x0a;Factor" MinWidth="80"
                                          Binding="{Binding AlternateUnitOfMeasureFactor, StringFormat=0.0#########, TargetNullValue=''}"/>
                <DataGridCheckBoxColumn Header="Use For&#x0a;% of Batch" Binding="{Binding IsPercentBatchOil, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Margin="4" Width="80" Command="{Binding SaveCommand}"/>
            <Button Content="Close" Margin="4" Width="80" Click="CloseButton_Click"/>
        </StackPanel>

        <Grid Grid.ColumnSpan="99" Grid.RowSpan="99" Background="Gray" Opacity="0.6"
              Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisConverter}}"/>
        <TextBlock Grid.ColumnSpan="99" Grid.RowSpan="99" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="24" FontStyle="Oblique" FontWeight="Bold" Text="Loading..."
                   Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisConverter}}"/>
    </Grid>
</Window>
