@page "/output"
@inject IDbContextFactory<TrackingStore> DbFactory
@inject NavigationManager Nav

@* Port of the WPF OutputHistory window: sales, losses and anything else leaving inventory. *@

<PageTitle>Output History</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Output History</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               Href="/output/new">Add Sale / Loss / Other</MudButton>
</MudStack>

@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    <MudTable Items="_rows" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm"
              Filter="FilterRow" OnRowClick="@((TableRowClickEventArgs<OutputRow> e) => Open(e.Item))"
              RowClass="cursor-pointer">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Total sales: @_rows.Sum(r => r.TotalSale).ToString("C2")</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_search" Placeholder="Search description"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0" Immediate="true" Clearable="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel InitialDirection="SortDirection.Descending"
                                   SortBy="new Func<OutputRow, object>(r => r.Date)">Date</MudTableSortLabel>
            </MudTh>
            <MudTh>Description</MudTh>
            <MudTh Style="text-align:right">Materials</MudTh>
            <MudTh Style="text-align:right">Products</MudTh>
            <MudTh Style="text-align:right">
                <MudTableSortLabel SortBy="new Func<OutputRow, object>(r => r.TotalSale)">Total Sale</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:48px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToShortDateString()</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Materials" Class="quarter-figure" Style="text-align:right">@context.MaterialLines</MudTd>
            <MudTd DataLabel="Products" Class="quarter-figure" Style="text-align:right">@context.ProductLines</MudTd>
            <MudTd DataLabel="Total Sale" Class="quarter-figure" Style="text-align:right">@context.TotalSale.ToString("C2")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Open(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100, int.MaxValue }" />
        </PagerContent>
    </MudTable>
}

@code {
    private sealed record OutputRow(
        int Id, DateTime Date, string? Description, decimal TotalSale, int MaterialLines, int ProductLines);

    private List<OutputRow>? _rows;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _rows = await db.OutRecords.AsNoTracking()
            .OrderByDescending(o => o.Date)
            .Select(o => new OutputRow(
                o.Id, o.Date, o.Description, o.TotalSale, o.Materials.Count, o.Products.Count))
            .ToListAsync();
    }

    private bool FilterRow(OutputRow row) =>
        string.IsNullOrWhiteSpace(_search)
        || (row.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);

    private void Open(OutputRow? row)
    {
        if (row is not null) Nav.NavigateTo($"/output/{row.Id}");
    }
}
