@page "/orders"
@inject IDbContextFactory<TrackingStore> DbFactory
@inject NavigationManager Nav

@* Port of the WPF OrderHistory window. *@

<PageTitle>Order History</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Order History</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               Href="/orders/new">Add Order</MudButton>
</MudStack>

@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    <MudTable Items="_rows" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm"
              Filter="FilterRow" OnRowClick="@((TableRowClickEventArgs<OrderRow> e) => Open(e.Item))"
              RowClass="cursor-pointer">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Total: @_rows.Sum(r => r.TotalCost).ToString("C2")</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_search" Placeholder="Search source or order number"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0" Immediate="true" Clearable="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel InitialDirection="SortDirection.Descending"
                                   SortBy="new Func<OrderRow, object>(r => r.OrderDate)">Order Date</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<OrderRow, object>(r => r.ReceiptDate ?? DateTime.MinValue)">Receipt Date</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<OrderRow, object>(r => r.Source ?? string.Empty)">Source</MudTableSortLabel>
            </MudTh>
            <MudTh>Order #</MudTh>
            <MudTh Style="text-align:right">Items</MudTh>
            <MudTh Style="text-align:right">
                <MudTableSortLabel SortBy="new Func<OrderRow, object>(r => r.TotalCost)">Total Cost</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:48px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Order Date">@context.OrderDate.ToShortDateString()</MudTd>
            <MudTd DataLabel="Receipt Date">
                @if (context.ReceiptDate is { } received)
                {
                    @received.ToShortDateString()
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                        not received
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Source">@context.Source</MudTd>
            <MudTd DataLabel="Order #">@context.OrderNumber</MudTd>
            <MudTd DataLabel="Items" Class="quarter-figure" Style="text-align:right">@context.OrderedItems</MudTd>
            <MudTd DataLabel="Total Cost" Class="quarter-figure" Style="text-align:right">@context.TotalCost.ToString("C2")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Open(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100, int.MaxValue }" />
        </PagerContent>
    </MudTable>
}

@code {
    private sealed record OrderRow(
        int Id, string? Source, string? OrderNumber, DateTime OrderDate,
        DateTime? ReceiptDate, int OrderedItems, decimal TotalCost);

    private List<OrderRow>? _rows;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _rows = await db.Orders.AsNoTracking()
            .OrderByDescending(o => o.DatePlaced)
            .Select(o => new OrderRow(
                o.Id,
                o.Source,
                o.OrderNumber,
                o.DatePlaced,
                o.DateReceived,
                o.OrderItems.Count,
                (o.Shipping ?? 0M) + (o.Tax ?? 0M)
                    + (o.OrderItems.Sum(oi => (decimal?)(oi.Quantity * oi.UnitPrice)) ?? 0M)
                    - (o.Discount ?? 0M)))
            .ToListAsync();
    }

    private bool FilterRow(OrderRow row) =>
        string.IsNullOrWhiteSpace(_search)
        || (row.Source?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        || (row.OrderNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);

    private void Open(OrderRow? row)
    {
        if (row is not null) Nav.NavigateTo($"/orders/{row.Id}");
    }
}
